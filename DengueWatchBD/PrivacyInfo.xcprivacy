<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- DengueWatch does not track users across apps or websites. -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- Nothing leaves the device. There is no account, no analytics SDK and
         no server that receives user data: the app only fetches a public
         surveillance dataset. Location, symptom checks, vital signs, lab
         reports, the fluid log and settings are all read and written on
         device, so none of it is "collected" in the sense this key means. A
         PDF of the health log leaves only when the reader shares it. -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <!-- UserDefaults stores the chosen language, home area, alert
                 preferences, the prevention checklist and the last sync time
                 — all of it this app's own data on this device. -->
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
