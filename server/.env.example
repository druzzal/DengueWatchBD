# Backend configuration. Copy to .env and fill in; .env is git-ignored.

# The DGHS surfaces this pipeline reads. Both are public; no key is required.
DGHS_DASHBOARD_URL=https://dashboard.dghs.gov.bd/pages/heoc_dengue_v1.php
DGHS_PRESS_RELEASE_BASE=https://old.dghs.gov.bd/images/docs/vpr

# Optional. Only needed if you move from serving the generated JSON as a static
# file to storing it in Supabase. The service-role key is privileged: it belongs
# in GitHub Actions secrets, never in the iOS app and never in this file
# committed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
